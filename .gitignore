.vscode/
CLAUDE.local.md
.worktrees/
coverage/
logs/

# iCloud sync artifacts
node_modules.nosync/
node_modules 2

# Scheduled agent scripts (machine-local, not for distribution)
scripts/agents/

# Internal docs (agent reports, plans, research, decisions, PRs)
docs/agents/
docs/plans/*
# Deviation notes stay tracked: /validate reads them, and a worktree teardown
# would otherwise destroy them. git cannot re-include a path whose parent
# directory is excluded, hence `docs/plans/*` rather than `docs/plans/`.
!docs/plans/*-notes.md
docs/research/
# ADRs are tracked: CLAUDE.md requires them to live here, and the schema
# migration policy requires one per bump. Without this exception new ADRs
# silently fail to commit (the three existing ones survive only by force-add).
!docs/decisions/
docs/prs/

# Release probe intermediates (the manifest under docs/release/evidence/ is the
# durable artifact; these are the raw inputs that produce it)
.release-results.json
.release-fixtures.json

# Local summon config
.summon

# Launch content (local only)
content/

# Gallery build staging (local only)
.gallery-build/

# Manual testbed
MANUAL_TESTBED.md

# Security-sensitive files
.npmrc
*.pem
*.key
credentials*.json

# Stray osacompile output from AppleScript syntax tests
*.scpt
